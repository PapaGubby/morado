{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Morado Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/apps/vscode-extension/dist/**/*.js"
      ],
      "preLaunchTask": "Build Morado"
    }
  ]
}
